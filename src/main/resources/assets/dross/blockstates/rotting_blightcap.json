{
  "multipart": [
    {
      "apply": {
        "model": "dross:block/rotting_blightcap"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "dross:block/rotting_blightcap",
        "y": 90,
        "uvlock": true
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "dross:block/rotting_blightcap",
        "y": 180,
        "uvlock": true
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "dross:block/rotting_blightcap",
        "y": 270,
        "uvlock": true
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "dross:block/rotting_blightcap",
        "x": 270,
        "uvlock": true
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "dross:block/rotting_blightcap",
        "x": 90,
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "dross:block/blightcap_inside"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "dross:block/blightcap_inside",
        "y": 90,
        "uvlock": false
      },
      "when": {
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "dross:block/blightcap_inside",
        "y": 180,
        "uvlock": false
      },
      "when": {
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "dross:block/blightcap_inside",
        "y": 270,
        "uvlock": false
      },
      "when": {
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "dross:block/blightcap_inside",
        "x": 270,
        "uvlock": false
      },
      "when": {
        "up": "false"
      }
    },
    {
      "apply": {
        "model": "dross:block/blightcap_inside",
        "x": 90,
        "uvlock": false
      },
      "when": {
        "down": "false"
      }
    }
  ]
}
